<?xml version="1.0" encoding="utf-8"?>
<!--
  Pet dashboard, built from the Figma frame "Mochi - Pet dashboard" (node 2:2046).
  The phone status bar and home indicator in the mock-up are drawn by Android itself,
  so they are not part of this layout.

  Built from the Healthy (2:2046), Tired (2:2147), Sick (2:2311) and Devastated (2:2476) frames. The room color, the
  two cards, the sprite, the backdrop and the condition icon change with the pet state.

  Images that must be exported from Figma into res/drawable (see README). Healthy ones
  are required (they are the defaults); the others are optional until you export them.
    pet_<state>            278 x 184 dp   (2:3 / 2:2283 / 2:2447 / 2:2612)
    room_backdrop_<state>  256 x 256 dp   (2:2071 / 2:2169 / 2:2333 / 2:2498)
    ic_condition_<state>    14 x  14 dp   (2:2076 / 2:2307 / 2:2472 / 2:2637)
    where <state> is healthy, tired, sick, devastated
    ic_nav_pet                         24 x  24 dp   (10:76)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Welcome -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/tvTagline"
                    style="@style/LoserText.Tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_tagline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/LoserText.Greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/welcome_greeting"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTagline" />

                <TextView
                    android:id="@+id/tvLimitsLink"
                    style="@style/LoserText.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="22dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/limits_link"
                    app:layout_constraintBottom_toBottomOf="@id/tvGreeting"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvGreeting" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pet room -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/petRoom"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:background="@drawable/bg_pet_room">

                <ImageView
                    android:id="@+id/ivBackdrop"
                    android:layout_width="256dp"
                    android:layout_height="256dp"
                    android:layout_marginTop="52dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/room_backdrop_healthy"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPetName"
                    style="@style/LoserText.PetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="17dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Mochi" />

                <LinearLayout
                    android:id="@+id/pillCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:minWidth="90dp"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivCondition"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/condition_content_description"
                        android:src="@drawable/ic_condition_healthy" />

                    <TextView
                        android:id="@+id/tvCondition"
                        style="@style/LoserText.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        tools:text="Healthy" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivPet"
                    android:layout_width="278dp"
                    android:layout_height="184dp"
                    android:layout_marginTop="74dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/pet_healthy"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:contentDescription="Mochi the pet is feeling Healthy" />

                <TextView
                    android:id="@+id/tvSpeech"
                    style="@style/LoserText.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="249dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:maxWidth="320dp"
                    android:minWidth="202dp"
                    android:minHeight="28dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="A little balance feels good!" />

                <TextView
                    style="@style/LoserText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="293dp"
                    android:text="@string/room_caption"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Today's screen time -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardScreenTime"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:id="@+id/tvScreenLabel"
                    style="@style/LoserText.CardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/screen_time_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTotal"
                    style="@style/LoserText.BigNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="1h 48m" />

                <TextView
                    android:id="@+id/tvLimitLine"
                    style="@style/LoserText.CardSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="76dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="of your 3h daily limit • 1h 12m left" />

                <TextView
                    android:id="@+id/tvViewUsage"
                    style="@style/LoserText.CardLink"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="34dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/view_usage"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pet condition card (background colour follows the pet state) -->
            <LinearLayout
                android:id="@+id/cardCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:minHeight="88dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvConditionTitle"
                    style="@style/LoserText.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Healthy: 1h 12m left" />

                <TextView
                    android:id="@+id/tvConditionBody"
                    style="@style/LoserText.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    tools:text="Well within your daily limit." />
            </LinearLayout>

            <!-- Automatic daily reset -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:minHeight="94dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/LoserText.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_title" />

                <TextView
                    android:id="@+id/tvResetLine"
                    style="@style/LoserText.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    tools:text="Mochi resets at midnight. Your daily usage is saved in your weekly history." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
