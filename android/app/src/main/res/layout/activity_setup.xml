<?xml version="1.0" encoding="utf-8"?>
<!--
  First-run setup (proposal, Phase 1): create the pet, set the daily limit and the reset time.
  The next step is the Connect screen (permissions). No bottom navigation here.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".SetupActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/LoserText.Greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/setup_title" />

            <TextView
                style="@style/LoserText.CardBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="@string/setup_subtitle" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_lavender">

                <ImageView
                    android:layout_width="178dp"
                    android:layout_height="118dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/pet_healthy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chart_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/LoserText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_pet_name_label" />

                <EditText
                    android:id="@+id/etPetName"
                    style="@style/LoserText.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="20"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:selectAllOnFocus="true"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />

                <TextView
                    style="@style/LoserText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/setup_limit_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etHours"
                        style="@style/LoserText.Headline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:contentDescription="@string/settings_hours"
                        android:hint="@string/settings_hours"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                    <EditText
                        android:id="@+id/etMinutes"
                        style="@style/LoserText.Headline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:contentDescription="@string/settings_minutes"
                        android:hint="@string/settings_minutes"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLimitHint"
                    style="@style/LoserText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:text="Choose 1 minute to 24 hours." />

                <TextView
                    style="@style/LoserText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/setup_reset_label" />

                <TextView
                    android:id="@+id/tvResetTime"
                    style="@style/LoserText.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    tools:text="12:00 AM" />

                <TextView
                    style="@style/LoserText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_reset_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFormError"
                style="@style/LoserText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:textColor="@color/warn_text"
                android:visibility="gone"
                tools:text="Pet names can have 1 to 20 characters."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btnContinue"
                style="@style/LoserText.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="17dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/setup_continue" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
