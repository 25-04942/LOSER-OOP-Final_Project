<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom navigation shared by every screen (used with <include>).
  Which tab is highlighted is set in code (BaseScreenActivity.setUpChrome):
  View.setSelected(true) on a tab turns on its pill, icon color and label color.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nav_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal">

        <!-- tab_pet -->
        <LinearLayout
            android:id="@+id/tabPet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_pet"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_nav_indicator">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_pet"
                    android:tint="@color/nav_tint" />
            </FrameLayout>

            <TextView
                style="@style/LoserText.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tab_pet" />
        </LinearLayout>

        <!-- tab_usage -->
        <LinearLayout
            android:id="@+id/tabUsage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_usage"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_nav_indicator">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_usage"
                    android:tint="@color/nav_tint" />
            </FrameLayout>

            <TextView
                style="@style/LoserText.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tab_usage" />
        </LinearLayout>

        <!-- tab_history -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_history"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_nav_indicator">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_history"
                    android:tint="@color/nav_tint" />
            </FrameLayout>

            <TextView
                style="@style/LoserText.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tab_history" />
        </LinearLayout>

        <!-- tab_settings -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_settings"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_nav_indicator">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="@color/nav_tint" />
            </FrameLayout>

            <TextView
                style="@style/LoserText.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
