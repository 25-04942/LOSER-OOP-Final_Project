<?xml version="1.0" encoding="utf-8"?>
<!-- One line of "Daily records": date, total, status. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_record"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvRecordDate"
        style="@style/LoserText.RecordMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp" />

    <TextView
        android:id="@+id/tvRecordTotal"
        style="@style/LoserText.RecordMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="140dp" />

    <TextView
        android:id="@+id/tvRecordStatus"
        style="@style/LoserText.RecordStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="242dp" />
</FrameLayout>
