<?xml version="1.0" encoding="utf-8"?>
<!-- One line in "By category": label, colored bar (160dp = the largest category), minutes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp">

    <TextView
        android:id="@+id/tvCategoryLabel"
        style="@style/LoserText.RowLabel"
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <ProgressBar
        android:id="@+id/barCategory"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="160dp"
        android:layout_height="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_category" />

    <TextView
        android:id="@+id/tvCategoryMinutes"
        style="@style/LoserText.RowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:gravity="end"
        android:maxLines="1" />
</LinearLayout>
